{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glasfaser-test",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glasfaser-test",
      "database_id": "62bcea1a-78a0-4e8b-82e0-2773b885c272",
      "migrations_dir": "cloud/migrations"
    }
  ],
  "observability": {
    "enabled": false
  },
  "account_id": "aa071db7364560328764134a2d15fb8c"
}
